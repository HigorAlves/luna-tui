{
  "name": "hardness",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm images && pnpm api-token && GH_TOKEN=\"${GH_TOKEN:-$(gh auth token 2>/dev/null)}\" LUNA_GIT_NAME=\"${LUNA_GIT_NAME:-$(git config user.name)}\" LUNA_GIT_EMAIL=\"${LUNA_GIT_EMAIL:-$(git config user.email)}\" MACHINE_STAGE_USER=\"${MACHINE_STAGE_USER:-$(id -u):$(id -g)}\" docker compose up -d --build --wait",
    "stop": "docker compose down",
    "api-token": "test -s \"$HOME/.config/hardness/machine-api-token\" || (umask 077 && mkdir -p \"$HOME/.config/hardness\" && openssl rand -hex 32 > \"$HOME/.config/hardness/machine-api-token\")",
    "dev": "docker compose stop machine 2>/dev/null; pnpm images && pnpm db:up && pnpm --filter @hardness/machine dev",
    "images": "bash machine/runner/build.sh --qa --video",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "board:build": "cargo build --release --manifest-path board/Cargo.toml",
    "board:link": "pnpm board:build && herdr plugin link ./board",
    "board:test": "cargo test --manifest-path board/Cargo.toml",
    "board:keys": "cargo run --manifest-path board/Cargo.toml -- --keys-md board/README.md",
    "golden": "pnpm --filter @hardness/machine golden",
    "eval": "node evals/cli.ts",
    "site:dev": "pnpm --filter site dev",
    "site:build": "pnpm --filter site build",
    "site:test": "pnpm --filter site test",
    "icons": "node scripts/export-icons.mjs",
    "icons:gen": "node scripts/gen-brand.mjs"
  }
}
