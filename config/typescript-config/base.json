{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node packages: erasable TypeScript run straight from source",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // TypeScript 7 no longer loads @types packages on its own.
    "types": ["node"]
  }
}
