    "@typesafe-ai/sdk": "0.7.0",
    "ai": "7.0.161",
    "eve": "1.0.0-rc.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
