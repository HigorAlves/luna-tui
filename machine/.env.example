# Defaults match compose.dev.yml, so a .env file is only needed to change them.
DATABASE_URL=postgres://hardness:hardness@127.0.0.1:5433/hardness
MACHINE_PORT=4317
# Poll GitHub issues into tasks (needs the gh CLI signed in). Empty repos: off.
# MACHINE_GITHUB_POLL=owner/name,owner/other
# MACHINE_GITHUB_POLL_INTERVAL=300
# MACHINE_GITHUB_LABEL=ready-for-agent
# Docker images for stage containers (pnpm runner:build builds the first).
# RUNNER_IMAGE=hardness-runner:dev
# RUNNER_QA_IMAGE=hardness-runner-qa:dev
# The QA image (e2e stage) is built by pnpm runner-qa:build; without it e2e is skipped.
