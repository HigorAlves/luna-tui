# Read by `pnpm dev` (the machine on the host). Defaults match compose.yaml's Postgres,
# so a .env file is only needed to change them. `docker compose up` doesn't read this file.
DATABASE_URL=postgres://hardness:hardness@127.0.0.1:5433/hardness
MACHINE_PORT=4317
# MACHINE_HOST=127.0.0.1
# Poll GitHub issues into tasks (needs the gh CLI signed in). Empty repos: off.
# MACHINE_GITHUB_POLL=owner/name,owner/other
# MACHINE_GITHUB_POLL_INTERVAL=300
# MACHINE_GITHUB_LABEL=ready-for-agent
# Where an imported issue's task works: owner/name=/abs/path pairs, else a scan of MACHINE_REPOS_DIR by origin.
# MACHINE_REPO_MAP=owner/name=/Users/me/Developer/name
# MACHINE_REPOS_DIR=~/Developer
# Replies in the thread a task came from (its GitHub issue; a Slack thread when the pair is set).
# MACHINE_THREAD_REPLIES=on
# MACHINE_SLACK_TOKEN=xoxb-...
# MACHINE_SLACK_CHANNEL=C0123456789
# The Slack inbox (the board's S view): your user token from the app in slack/manifest.json, and
# the app-level token for Socket Mode (reactions, instant updates). Triage runs as the slack_triage pack
# with the same credential and Docker image as the stages; MACHINE_AGENTS=off turns it off with them.
# MACHINE_SLACK_USER_TOKEN=xoxp-...
# MACHINE_SLACK_APP_TOKEN=xapp-...
# MACHINE_SLACK_INBOX=on
# MACHINE_SLACK_INBOX_INTERVAL=60
# MACHINE_SLACK_MARK_READ=off
# The triage rules you edit; default <MACHINE_STATE_DIR>/slack-triage.md, a relative path is from the repo root.
# MACHINE_SLACK_RULES=/Users/me/.local/state/hardness/slack-triage.md
# MACHINE_SLACK_DIGEST_AT=08:30
# Jira Cloud: the site, your Atlassian email and an API token from id.atlassian.com (Security → API tokens).
# All three or none; MACHINE_JIRA=off disables everything Jira. Each repo's luna.yaml `jira:` block says what syncs.
# MACHINE_JIRA_SITE=https://acme.atlassian.net
# MACHINE_JIRA_EMAIL=you@acme.com
# MACHINE_JIRA_TOKEN=...
# For a scoped API token only: calls go through https://api.atlassian.com/ex/jira/<cloud id> instead of the site.
# MACHINE_JIRA_CLOUD_ID=
# MACHINE_JIRA=on
# Datadog inbox (board view O): an API key and an application key (scopes incident_read, monitors_read,
# logs_read_data, error_tracking_read). Both or neither. Triage runs as the datadog_triage pack (haiku).
# MACHINE_DATADOG_API_KEY=
# MACHINE_DATADOG_APP_KEY=
# MACHINE_DATADOG_SITE=datadoghq.com
# Appended to every monitor, log and Error Tracking query, e.g. env:prod team:payments
# MACHINE_DATADOG_SCOPE=
# MACHINE_DATADOG_INBOX=on
# MACHINE_DATADOG_INTERVAL=120
# Ticket SLAs where a repo's luna.yaml `sla:` block says nothing: how long a gate may wait on you, and created-to-closed.
# MACHINE_SLA_GATE=1h
# MACHINE_SLA_CYCLE=off
# Tasks that may drive one stage at once, e.g. two implementers and one browser run.
# MACHINE_MAX_PER_STAGE=implementing=2,e2e=1
# Docker images for stage containers (pnpm runner:build builds the first).
# RUNNER_IMAGE=hardness-runner:dev
# RUNNER_QA_IMAGE=hardness-runner-qa:dev
# The QA image (e2e stage) is built by pnpm runner-qa:build; without it e2e is skipped.
# Agents off entirely (every stage becomes a stub, no credential or Docker needed).
# MACHINE_AGENTS=off
# Where task worktrees are created (default: a temp dir next to the repo).
# WORKTREES_DIR=/path/to/worktrees
# Where run artifacts, transcripts and ingested output live.
# MACHINE_STATE_DIR=/path/to/state
# Days to keep closed tasks' events/stage-runs before pruning (0 disables pruning).
# MACHINE_RETENTION_DAYS=90
# Days after a task closes before its worktree is removed and its merged branch deleted (0 disables).
# MACHINE_WORKTREE_RETENTION_DAYS=7
# On shutdown, a task mid-stage goes back to the queue (requeue) or waits for you (escalate).
# MACHINE_RESTART_POLICY=requeue
# Spend ceilings in USD; unset means none. A task over its own escalates; a day over its parks the queue.
# MACHINE_TASK_BUDGET_USD=5
# MACHINE_DAILY_BUDGET_USD=40
