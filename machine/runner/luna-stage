#!/bin/sh
# The stage's entry in any image that carries the machine's layer: the factory on the layer's own Node. Shell builtins and
# absolute paths in /opt/luna only: the base image's own tools are never called by name here.
export PATH="/opt/luna/bin:$PATH"
export LUNA_FACTORY_ROOT=/opt/luna/factory-src/factory
export CODEX_HOME="${CODEX_HOME:-/tmp/.codex}" EVE_TELEMETRY_DISABLED=1 GOTOOLCHAIN="${GOTOOLCHAIN:-local}"
exec /opt/luna/bin/node /opt/luna/factory-src/factory/src/main.ts "$@"
