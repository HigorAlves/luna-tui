{
  "name": "@hardness/machine",
  "private": true,
  "type": "module",
  "exports": {
    "./run-once": "./src/application/stages/run-once.ts",
    "./pack-runner": "./src/application/stages/pack-runner.ts",
    "./exec": "./src/adapters/process/exec.ts",
    "./design-bridge": "./src/application/stages/design-bridge.ts",
    "./mcp-replay": "./src/adapters/mcp/replay.ts",
    "./credentials": "./src/adapters/credentials/index.ts",
    "./docker": "./src/adapters/docker/docker.ts",
    "./telemetry": "./src/bootstrap/telemetry.ts",
    "./egress": "./src/bootstrap/egress.ts",
    "./config": "./src/config.ts",
    "./egress-kind": "./src/domain/egress-kind.ts",
    "./policy": "./src/application/policy.ts",
    "./decisions": "./src/bootstrap/decisions.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx scripts/openapi.ts",
    "db:migrate": "tsx node_modules/typeorm/cli.js migration:run -d src/adapters/persistence/data-source.ts",
    "db:revert": "tsx node_modules/typeorm/cli.js migration:revert -d src/adapters/persistence/data-source.ts",
    "db:generate": "tsx node_modules/typeorm/cli.js migration:generate -d src/adapters/persistence/data-source.ts",
    "runner:build": "bash runner/build.sh",
    "runner-qa:build": "bash runner/build.sh --qa",
    "runner-video:build": "bash runner/build.sh --video",
    "runner-video:smoke": "bash runner-video/smoke.sh",
    "smoke:sandbox": "tsx scripts/smoke-sandbox.mjs",
    "relay:smoke": "tsx runner/egress/relay-smoke.ts",
    "golden": "node scripts/golden-task.mjs",
    "gates": "tsx scripts/github-gates.mjs",
    "golden:concurrency": "node scripts/golden-concurrency.mjs",
    "golden:abort": "node scripts/golden-abort.mjs",
    "golden:retry": "node scripts/golden-retry.mjs",
    "golden:live": "node scripts/golden-abort.mjs && node scripts/golden-retry.mjs && node scripts/golden-concurrency.mjs"
  },
  "devDependencies": {
    "@hardness/typescript-config": "workspace:*",
    "@hardness/vitest-config": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "4.0.2",
    "@types/pngjs": "6.0.5",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hardness/contracts": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@lmnr-ai/lmnr": "^0.8.58",
    "@modelcontextprotocol/sdk": "1.32.1",
    "hono": "^4.13.13",
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "picomatch": "4.0.7",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "typeorm": "^1.1.2",
    "yaml": "2.8.3",
    "zod": "^4.6.7"
  }
}
